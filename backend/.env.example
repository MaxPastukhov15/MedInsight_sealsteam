# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/medical_analytics

# Redis Configuration
REDIS_URL=redis://localhost:6379

# LLM Provider Configuration
# Options: ollama, together, openai, cohere
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434

# API Keys (uncomment if using cloud providers)
# TOGETHER_API_KEY=your_together_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# COHERE_API_KEY=your_cohere_api_key_here

# Application Settings
DEBUG=True
LOG_LEVEL=INFO
ENVIRONMENT=development

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Cache TTL (seconds)
CACHE_TTL_REALTIME=120
CACHE_TTL_FORECAST=1800
CACHE_TTL_RECOMMENDATIONS=3600
