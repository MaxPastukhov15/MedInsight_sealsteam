# .gitignore для dev-архитектуры
# Игнорировать временные файлы, секреты, виртуальное окружение

# VS Code
.vscode/

# Python venv
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# Секреты и env-файлы
.env

# IDE-файлы
.idea/
*.swp
*.swo
*~

# Тестовые отчёты
htmlcov/
.coverage
.pytest_cache/

# Мусор и дампы
*.log
*.tmp
*.bak
*.db
.DS_Store

# Pre-commit cache
.pre-commit-framework/