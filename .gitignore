# .gitignore для dev-архитектуры
# Игнорировать временные файлы, секреты, виртуальное окружение

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python cache и compiled files
__pycache__
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# VS Code
.vscode/

# Секреты и env-файлы
.env
.env.local
.env.*.local

# IDE-файлы
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Тестовые отчёты и coverage
htmlcov/
.coverage
.coverage.*
.pytest_cache/
.tox/
.nox/
coverage.xml
*.cover

# Логи и временные файлы
*.log
*.tmp
*.bak
*.db
*.sqlite
*.sqlite3

# OS файлы
.DS_Store
Thumbs.db

# Pre-commit cache
.pre-commit-framework/

# MyPy cache
.mypy_cache/
.dmypy.json
dmypy.json

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# База данных
*.parquet
